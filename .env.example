# Plantilla de variables de entorno. Copia este archivo a `.env` y ajusta los valores.
# Este es el ÚNICO archivo .env que se versiona (ver "Límites duros" en tech-stack.md).

# Credenciales del contenedor de PostgreSQL para desarrollo local (docker-compose.yml).
POSTGRES_USER="laguaira"
POSTGRES_PASSWORD="laguaira"
POSTGRES_DB="unidos_por_la_guaira"

# Cadena de conexión que usa Prisma.
# - Desarrollo: el PostgreSQL levantado por `docker compose up -d` (publicado en el
#   puerto 5435 del host para no chocar con otro Postgres que use el 5432).
# - Producción: la base de Supabase.
DATABASE_URL="postgresql://laguaira:laguaira@localhost:5432/unidos_por_la_guaira?schema=public"

# URL pública del sitio (SEO: canonical, Open Graph, sitemap). En desarrollo suele ser
# http://localhost:3000; en producción, el dominio real (p. ej. https://unidosporlaguaira.org).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secreto para firmar los JWT de sesión. Genera uno con: `openssl rand -base64 32`
# (o `npx auth secret`). Obligatorio en producción.
AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio"

# ── Supabase Storage (feature 031: imágenes y documentación de solicitudes) ──
# Almacenamiento de los archivos que sube el solicitante. El binario vive en un
# bucket PRIVADO de Supabase; la app guarda solo la ruta y sirve por URL firmada.
# - SUPABASE_URL: URL del proyecto (https://<ref>.supabase.co). Es la misma que
#   Supabase entrega como NEXT_PUBLIC_SUPABASE_URL; el código acepta cualquiera de
#   las dos, así que puedes dejar solo NEXT_PUBLIC_SUPABASE_URL si ya la tienes.
# - SUPABASE_SERVICE_ROLE_KEY: la clave SECRETA (service_role, o la "secret key"
#   sb_secret_… del nuevo formato). SOLO SERVIDOR, nunca NEXT_PUBLIC_. NO es la
#   "publishable"/anon (esa es pública y no sirve para firmar subidas al bucket
#   privado). La subida usa URLs firmadas de un solo uso emitidas en el servidor.
# - SUPABASE_STORAGE_BUCKET: nombre del bucket privado (créalo, p. ej. "solicitudes").
#   El MISMO bucket guarda también la evidencia de verificación del auditor (feature
#   032) bajo el prefijo `auditoria/`. Como esa evidencia admite VIDEO, configura en el
#   bucket un límite de tamaño de 50 MB (tope del plan Free de Supabase) y permite los
#   MIME de imagen, video (mp4/webm/quicktime) y application/pdf.
# - SUPABASE_STORAGE_BUCKET_PUBLICO: nombre del bucket PÚBLICO para las imágenes y
#   documentos de las actividades (feature 033; créalo, p. ej. "actividades", y márcalo
#   como público en Supabase). Se sirve por URL pública permanente porque se muestra en
#   la transparencia sin sesión. La subida sigue usando URLs firmadas de un solo uso.
# En desarrollo local basta con apuntar a un proyecto Supabase real; sin estas
# variables, subir archivos falla pero el resto de la app funciona.
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="cambia-esto-por-la-clave-secreta-service-role"
SUPABASE_STORAGE_BUCKET="solicitudes"
SUPABASE_STORAGE_BUCKET_PUBLICO="actividades"

# ── WhatsApp Cloud API (feature 012: notificaciones por WhatsApp) ───────────
# Canal de notificaciones por WhatsApp vía Meta Cloud API. Es PLUG-N-PLAY: si estas
# variables están vacías, el canal es no-op y solo funciona la notificación in-app;
# al colocar las credenciales y aprobar las plantillas en Meta, se activa solo.
# SOLO SERVIDOR: el token es secreto, nunca NEXT_PUBLIC_ ni subir valores reales.
# - WHATSAPP_ACCESS_TOKEN: token de acceso (permanente/system user) de la app de Meta.
# - WHATSAPP_PHONE_NUMBER_ID: id del número emisor (WhatsApp > API Setup).
# - WHATSAPP_API_VERSION: versión de la Graph API (por defecto v21.0 si se omite).
# - WHATSAPP_LANG: código de idioma de las plantillas (por defecto "es").
# - WHATSAPP_TEMPLATE_*: nombre EXACTO de cada plantilla aprobada en Meta. Si falta
#   la de un tipo, ese aviso no sale por WhatsApp (el otro tipo sí). Textos sugeridos
#   de plantilla en DOC/features/012-notificaciones.md.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_LANG="es"
WHATSAPP_TEMPLATE_NUEVA_ACTIVIDAD=""
WHATSAPP_TEMPLATE_META_CUMPLIDA=""
WHATSAPP_TEMPLATE_NUEVO_APORTE=""
WHATSAPP_TEMPLATE_ESTADO_APORTE=""
WHATSAPP_TEMPLATE_NUEVA_AFILIACION=""
WHATSAPP_TEMPLATE_AFILIACION_REMOVIDA=""
WHATSAPP_TEMPLATE_NUEVA_SOLICITUD_ZONA=""
WHATSAPP_TEMPLATE_ESTADO_SOLICITUD=""
WHATSAPP_TEMPLATE_ACTUALIZACION_AUDITORIA=""
WHATSAPP_TEMPLATE_NUEVA_SOLICITUD_AUDITABLE=""
WHATSAPP_TEMPLATE_RESULTADO_PROPUESTA_RECURSO=""
WHATSAPP_TEMPLATE_RESULTADO_TESTIMONIO=""
WHATSAPP_TEMPLATE_NUEVO_ADMIN_PENDIENTE=""
WHATSAPP_TEMPLATE_ESTADO_CUENTA_ADMIN=""

# ── Webhook y OTP de WhatsApp (feature 037) ────────────────────────────────
# SOLO SERVIDOR. El verify token es un secreto aleatorio elegido por nosotros y
# debe coincidir exactamente con el introducido en Meta > WhatsApp > Configuration.
# META_APP_SECRET se obtiene en Meta > App settings > Basic y valida la firma de
# cada POST. WHATSAPP_TEMPLATE_LOGIN_OTP es el nombre exacto de la plantilla
# AUTHENTICATION aprobada con botón "Copy code".
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
META_APP_SECRET=""
WHATSAPP_TEMPLATE_LOGIN_OTP="login_otp"

# ── Email SMTP (feature 036: notificaciones por correo) ─────────────────────
# Cuenta institucional exclusivamente emisora. El canal es plug-and-play: si
# falta cualquiera de estas variables, Email queda deshabilitado y la app sigue
# operando con in-app y WhatsApp. Todas son SOLO SERVIDOR.
# Puerto habitual: 465 con SMTP_SECURE="true"; 587 con SMTP_SECURE="false"
# (STARTTLS, según el proveedor). SMTP_FROM_EMAIL es el remitente visible.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="notificaciones@unidosporlaguaira.org"
SMTP_FROM_NAME="Unidos por Guayana"

# ── Seed del SUPERADMIN inicial (`pnpm db:seed`) ────────────────────────────
# Raíz de confianza (feature 015): no se crea desde el registro público; se
# siembra con estas credenciales y es la única autoridad que aprueba cuentas
# ADMIN. Los ADMIN ya NO se siembran: se registran públicamente (quedan en
# PENDIENTE hasta que el SUPERADMIN los aprueba). No subir valores reales al repo.
SUPERADMIN_EMAIL="superadmin@unidosporlaguaira.org"
SUPERADMIN_PASSWORD="cambia-esta-contraseña"
SUPERADMIN_NOMBRE="Superadministrador"

# ── Seed de usuarios de prueba (opcional, solo desarrollo) ─────────────────
# Si defines estos, el seed crea un COLABORADOR y un SOLICITANTE listos para
# probar 006 (aportes) y 007 (solicitudes) sin registrarlos por la UI. En
# producción déjalos vacíos y el seed los omite.
COLABORADOR_EMAIL=""
COLABORADOR_PASSWORD=""
COLABORADOR_NOMBRE="Colaborador Prueba"

SOLICITANTE_EMAIL=""
SOLICITANTE_PASSWORD=""
SOLICITANTE_NOMBRE="Solicitante Prueba"
